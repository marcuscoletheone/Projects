<!DOCTYPE html>
<html>
<head>
  <title>Custom 7‑Dice Grid Roller</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 20px;
      background: linear-gradient(135deg, #f0f4ff, #e8f9f1);
      color: #333;
    }

    h1 {
      color: #2a3d66;
    }

    #grid {
      display: grid;
      grid-template-columns: repeat(6, 60px);
      grid-template-rows: repeat(6, 60px);
      gap: 6px;
      margin: 25px auto;
      width: max-content;

      /* 3D board effect */
      background: #ffffff;
      padding: 20px;
      border-radius: 15px;
      box-shadow: 
        0 4px 8px rgba(0,0,0,0.15),
        inset 0 0 10px rgba(0,0,0,0.05);
    }

    .cell {
      width: 60px;
      height: 60px;
      background: #fafafa;
      border-radius: 8px;
      border: 1px solid #d0d0d0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      transition: background 0.2s, transform 0.2s;
    }

    .highlight {
      background: #ffe066;
      border-color: #ffcc33;
      transform: translateY(-3px);
      box-shadow: 0 3px 6px rgba(0,0,0,0.2);
      font-weight: bold;
    }

    button {
      padding: 12px 25px;
      font-size: 1.2rem;
      margin-top: 20px;
      cursor: pointer;
      background: #4a6fa5;
      color: white;
      border: none;
      border-radius: 8px;
      box-shadow: 0 3px 6px rgba(0,0,0,0.2);
      transition: background 0.2s;
    }

    button:hover {
      background: #3b5a85;
    }

  #results {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .die {
    background: white;
    padding: 8px 12px;
    border-radius: 10px;
    box-shadow: 0 0 6px rgba(0,0,0,0.15);
    font-size: 0.9rem;
    display: inline-block;
  }
    }
  </style>
</head>

<body>
  <h1>Custom 7‑Dice Grid Roller</h1>
  <button onclick="rollAll()">Roll All Dice 🎲</button>

  <div id="results"></div>

  <div id="grid"></div>

  <script>
    const dice = [
      { name: "Die 1", faces: ["F2", "A5", "F2", "A5", "E1", "B6"] },
      { name: "Die 2", faces: ["F6", "A4", "D6", "C5", "C6", "B5"] },
      { name: "Die 3", faces: ["B2", "B1", "A3", "A2", "C2", "B3"] },
      { name: "Die 4", faces: ["D4", "B4", "E3", "C4", "C3", "D3"] },
      { name: "Die 5", faces: ["E6", "E5", "E4", "D5", "F5", "F4"] },
      { name: "Die 6", faces: ["C1", "A1", "D2", "D1", "F3", "E2"] },
      { name: "Die 7", faces: ["F1", "A6", "F1", "A6", "F1", "A6"] }
    ];

    const rows = ["A","B","C","D","E","F"];
    const cols = ["1","2","3","4","5","6"];

    function buildGrid() {
      const grid = document.getElementById("grid");
      grid.innerHTML = "";
      for (let r = 0; r < 6; r++) {
        for (let c = 0; c < 6; c++) {
          const cell = document.createElement("div");
          cell.className = "cell";
          cell.id = rows[r] + cols[c];
          cell.innerText = rows[r] + cols[c];
          grid.appendChild(cell);
        }
      }
    }

    function clearHighlights() {
      document.querySelectorAll(".cell").forEach(cell => {
        cell.classList.remove("highlight");
      });
    }

    function rollAll() {
      clearHighlights();

      let html = "";
      dice.forEach(die => {
        const value = die.faces[Math.floor(Math.random() * die.faces.length)];
        html += `<div class="die"><strong>${die.name}:</strong> ${value}</div>`;

        const cell = document.getElementById(value);
        if (cell) cell.classList.add("highlight");
      });

      document.getElementById("results").innerHTML = html;
    }

    buildGrid();
  </script>
</body>
</html>
</body>
</html>
